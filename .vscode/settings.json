{
    "omnisharp.enableEditorConfigSupport": true,
    "dotnet.formatting.organizeImportsOnFormat": true,
    "dotnet.unitTests.runSettingsPath": "./tests/TestSettings.runsettings",
    "dotnet.defaultSolution": "SharpProjectStarter.slnx",
    "git.enableSmartCommit": true,
    "git.enableCommitSigning": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "always"
    },
    "editor.rulers": [
        120
    ],
    "[csharp]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode"
    },
    "[xml]": {
        "editor.defaultFormatter": "csharpier.csharpier-vscode"
    },
    "json.schemaDownload.trustedDomains": {
        "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json": true
    },
    "cSpell.words": [
        "Analyser",
        "autobuild",
        "changefreq",
        "cobertura",
        "codecov",
        "codeql",
        "cooldown",
        "cref",
        "docfx",
        "globaltool",
        "Lindhart",
        "Meziantou",
        "msbuild",
        "Randomizer",
        "reportgenerator",
        "Roslynator",
        "runsettings",
        "signoff",
        "targetdir",
        "Werebunny",
        "Werecodent",
        "xunit"
    ],
    "cSpell.ignorePaths": [
        "**/usr/local/share/dotnet",
        "**/var/folders/",
        ".vscode/",
        "artifacts/",
        "site/template/",
        ".editorconfig",
        ".gitignore",
        "nuget.config"
    ],
}